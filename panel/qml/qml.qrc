<RCC>
    <!-- 资源路径 = prefix + 条目名。C++ 侧必须加载 qrc:/C2Panel/main.qml，
         且 qmldir 也要进资源，Theme 的 singleton 声明才生效。 -->
    <qresource prefix="/C2Panel">
        <file>qmldir</file>
        <file>main.qml</file>
        <file>Theme.qml</file>
        <file>LoginPage.qml</file>
        <file>MainPage.qml</file>
        <file>AgentList.qml</file>
        <file>ShellTab.qml</file>
        <file>McpTab.qml</file>
        <file>FileTab.qml</file>
        <file>ScreenTab.qml</file>
    </qresource>
</RCC>
